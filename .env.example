OPENAI_API_KEY=
# LangChain provider string, e.g. openai:gpt-4o-mini
JD_LLM_MODEL=openai:gpt-4o-mini
LANGSMITH_API_KEY=

# Same Supabase project as mylinkedge.fullstack.
# Server-only secret key (sb_secret_...); never expose to browsers.
# Dashboard: Settings > API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Live graph integration test (tests/graphs/integration_test_jd_extract_graph.py).
# Test row must have origin_type=copy_paste and non-empty origin_jd (invoke is jd_id-only).
# RUN_JD_EXTRACT_INTEGRATION=1
# JD_EXTRACT_TEST_JD_ID=

# Live gap_collect integration test (tests/graphs/integration_test_gap_collect_graph.py).
# Session must join a job_description with extraction_status=done and non-empty skills.
# Also needs NEO4J_* (skills graph + held skills). Invoke is session_id-only.
# RUN_GAP_COLLECT_INTEGRATION=1
# GAP_COLLECT_TEST_SESSION_ID=

# Live resolve_company integration test (tests/graphs/integration_test_resolve_company.py).
# Needs LocalStack SNS + a running event hub consuming the lookup queue.
# Company name must exist as Company.name in the Neo4j data graph.
# RUN_RESOLVE_COMPANY_INTEGRATION=1
# RESOLVE_COMPANY_TEST_COMPANY_NAME=Jifiti
# RESOLVE_COMPANY_TEST_COMPANY_ID=  # optional exact id; else NEO4J_* cross-check if set

# Skill matching (mylinkedge-agent-tools-skill-matching). jd_extract skill extraction now runs
# on the event-hub skill_extract worker; NEO4J_* is still needed in-process by gap_collect.
# Required:
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATA_DATABASE=data
NEO4J_TAXONOMY_DATABASE=taxonomy
# LLM / embeddings via local LiteLLM (skills.ai.ioc platform/cicd/local):
LITELLM_API_BASE=http://localhost:4000/v1
LITELLM_MASTER_KEY=sk-local-litellm
SKILL_MATCHING_LLM_MODEL=gpt-4o-mini
GRAPH_EMBEDDING_OPENAI_MODEL=text-embedding-3-small
GRAPH_EMBEDDING_DIMENSIONS=384
# GRAPH_EMBEDDING_OPENAI_BASE_URL=   # defaults to LITELLM_API_BASE
# Lexical name search:
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_NAME=skills_by_name

# Event hub (mylinkedge-agent-tools-event-hub → LocalStack SNS).
# Per-topic ARNs from skills.ai.ioc/localstack stack-outputs.env after deploy.
SNS_LIFECYCLE_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:lifecycle
SNS_LOOKUP_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:lookup
SNS_EXPAND_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:expand
# Utility family: jd_extract publishes extract_skills here (handled by graph-tools skill_extract).
SNS_UTILITY_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:utility
# Optional fallback when the four ARNs above are unset. This stack has no process-events topic.
# SNS_PROCESS_EVENTS_TOPIC_ARN=
# JD_LIFECYCLE_EVENTS_ENABLED=1
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# Status API used by resolve_company (publish company_lookup, then poll GET /events/{id})
# and collect_section_skill_results (batch poll extract_skills via GET /events?event_id=...).
# Must match the hub process (EVENT_HUB_HTTP_PORT / EVENT_HUB_SERVICE_SECRET).
# Local fullstack often uses 3001; iac default is 3100.
EVENT_HUB_STATUS_BASE_URL=http://localhost:3001
EVENT_HUB_SERVICE_SECRET=change-me-event-hub-status

# SQS container (`make sqs-worker`). Queue names come from
# skills.ai.ioc/localstack/stack-outputs.env after `./localstack/deploy.sh`.
SQS_QUEUE_URL_PREFIX=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000
SQS_QUEUE_NAME=skills-ai-local-agent-jd-events
# AgentJdEventsDlqUrl from that same stack-outputs.env
SQS_DLQ_URL=
# Optional: raise visibility if a graph run exceeds the queue default (60s).
# SQS_VISIBILITY_TIMEOUT_SECONDS=60
# SQS_MAX_IN_FLIGHT=10

# HTTP thread API (`make http-server` / `--container http`).
SERVICE_SECRET=
SESSION_JWT_SECRET=
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# HTTP_MAX_MESSAGE_CHARS=16000
# HTTP_RATE_LIMIT_PER_MINUTE=60
# API_CORS_ORIGINS=*

# gRPC GraphTurnService checkpointer (same as mylinkedge.agent.interview).
MONGODB_URI=mongodb://mongo:password123@localhost:27017
MONGODB_DB=skillsai
# Optional LangGraph checkpointer overrides (defaults: MONGODB_DB + checkpoints/checkpoint_writes).
# MONGODB_CHECKPOINT_DB=skillsai
# MONGODB_CHECKPOINT_COLLECTION=checkpoints
# MONGODB_CHECKPOINT_WRITES_COLLECTION=checkpoint_writes
