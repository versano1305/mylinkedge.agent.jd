OPENAI_API_KEY=
# LangChain provider string, e.g. openai:gpt-4o-mini
JD_LLM_MODEL=openai:gpt-4o-mini
LANGSMITH_API_KEY=

# Same Supabase project as mylinkedge.fullstack.
# Server-only secret key (sb_secret_...); never expose to browsers.
# Dashboard: Settings > API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Live graph integration test (tests/graphs/integration_test_jd_extract_graph.py).
# Test row must have origin_type=copy_paste and non-empty origin_jd (invoke is jd_id-only).
# RUN_JD_EXTRACT_INTEGRATION=1
# JD_EXTRACT_TEST_JD_ID=

# Live gap_collect integration test (tests/graphs/integration_test_gap_collect_graph.py).
# Session must join a job_description with extraction_status=done and non-empty skills.
# Also needs NEO4J_* (skills graph + held skills). Invoke is session_id-only.
# RUN_GAP_COLLECT_INTEGRATION=1
# GAP_COLLECT_TEST_SESSION_ID=

# Skill matching (mylinkedge-agent-tools-skill-matching / relevant_skills_from_text)
# Required:
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATA_DATABASE=data
NEO4J_TAXONOMY_DATABASE=taxonomy
# LLM / embeddings via local LiteLLM (skills.ai.ioc platform/cicd/local):
LITELLM_API_BASE=http://localhost:4000/v1
LITELLM_MASTER_KEY=sk-local-litellm
SKILL_MATCHING_LLM_MODEL=gpt-4o-mini
GRAPH_EMBEDDING_OPENAI_MODEL=text-embedding-3-small
GRAPH_EMBEDDING_DIMENSIONS=384
# GRAPH_EMBEDDING_OPENAI_BASE_URL=   # defaults to LITELLM_API_BASE
# Lexical name search:
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_NAME=skills_by_name

# Process events (mylinkedge-agent-tools-event-hub → SNS process-events)
# LocalStack defaults from skills.ai.ioc/localstack:
SNS_PROCESS_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:process-events
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# SQS container (`make sqs-worker`). Queue names come from
# skills.ai.ioc/localstack/stack-outputs.env after `./localstack/deploy.sh`.
SQS_QUEUE_URL_PREFIX=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000
SQS_QUEUE_NAME=skills-ai-local-agent-jd-events
# AgentJdEventsDlqUrl from that same stack-outputs.env
SQS_DLQ_URL=
# Optional: raise visibility if a graph run exceeds the queue default (60s).
# SQS_VISIBILITY_TIMEOUT_SECONDS=60
# SQS_MAX_IN_FLIGHT=10
